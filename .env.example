# ==============================================================
# Handy Backend — variables de entorno de ejemplo
# Copia este archivo como .env y reemplaza los valores.
# NINGÚN valor aquí es real ni debe usarse en producción.
# ==============================================================

# Entorno de ejecución: development | production
# - synchronize (TypeORM) solo está activo cuando NO es 'production'.
# - Swagger /api/docs solo se monta cuando NO es 'production'.
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=usuario_ejemplo
DB_PASSWORD=contrasena_ejemplo
DB_DATABASE=nombre_base_datos_ejemplo

# --- JWT ---
# Usa una cadena larga y aleatoria (p. ej. generada con `openssl rand -hex 64`).
JWT_SECRET=reemplaza-por-una-clave-larga-y-aleatoria
# Duración del token: segundos ('900') o intervalos de jsonwebtoken ('15m', '1d').
JWT_EXPIRATION=15m

# --- CORS ---
# Orígenes permitidos, separados por comas. Si se omite fuera de producción,
# se permite cualquier origen. En producción es obligatoria y no admite "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Rate limiting (opcional; valores por defecto si se omiten) ---
# Ventana de tiempo en milisegundos y límite global de peticiones por IP.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Nota: POST /auth/login y POST /auth/register tienen un límite fijo estricto
# de 5 peticiones por minuto por IP.

# --- Seed de datos iniciales (solo se usan con `npm run seed`) ---
# Credenciales del admin inicial. NINGÚN valor aquí es real; define unos
# propios en tu .env. La contraseña nunca se escribe en el código ni en el
# repositorio.
ADMIN_EMAIL=admin@ejemplo.local
ADMIN_PASSWORD=cambia-esta-clave-minimo-8-caracteres
ADMIN_NOMBRE=Administrador de Ejemplo
# Los municipios base se cargan desde src/seed/municipios.json (reemplaza el
# archivo de ejemplo por la lista oficial de Córdoba, Colombia).
